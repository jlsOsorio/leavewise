# Copy to `.env` (never commit it) and replace the placeholders.
# Used by docker-compose.yml. Values marked "required" make `docker compose up` fail fast when missing.
# The dev profile (`./mvnw spring-boot:run -Dspring-boot.run.profiles=dev`) defaults to the same
# local credentials, so it works against `docker compose up -d postgres rabbitmq` without this file.

# --- Backend --------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://postgres:5432/leavewise
DB_USER=leavewise
DB_PASSWORD=leavewise

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=leavewise
RABBITMQ_PASSWORD=leavewise

# JWT: base64, at least 256 bits (required). Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
# ISO-8601 durations
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# Uploaded Excel files (mounted on the `uploads` volume)
STORAGE_PATH=/data/uploads

# Optional: AI reason text for suggestions; leave empty to disable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Seeded on startup if missing (required, except ADMIN_NAME and SEED_COUNTRY)
ADMIN_EMAIL=admin@leavewise.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator
SEED_COMPANY_NAME=LeaveWise
SEED_LOCATION_NAME=Lisboa
# Municipality (concelho) of the seeded location
SEED_MUNICIPALITY=Lisboa
SEED_DISTRICT=Lisboa
# Optional; blank defaults to Portugal (in the seeder code)
SEED_COUNTRY=Portugal

# --- Frontend -------------------------------------------------------------
# Backend as seen from the frontend container
BACKEND_URL=http://backend:8080
# true behind HTTPS; false for plain http://localhost
COOKIE_SECURE=false
